{
    "stable": true,
    "versions": {
        "0.1.18": {
            "manifest": {
                "manifestVersion": 2,
                "id": "com.finbook.mpm-kind",
                "title": "MPM Kind",
                "version": "0.1.18",
                "httpPort": 8000,
                "healthCheckPath": "/healthz",
                "memoryLimit": 1073741824,
                "addons": {
                    "postgresql": {},
                    "localstorage": {},
                    "proxyAuth": {},
                    "scheduler": {
                        "mutter_pull": {
                            "schedule": "*/5 * * * *",
                            "command": "mpm run gateway_mutter_pull"
                        },
                        "heartbeat_alpaca_live": {
                            "schedule": "*/5 * * * *",
                            "command": "mpm heartbeat alpaca_live"
                        },
                        "heartbeat_alpaca_paper": {
                            "schedule": "*/5 * * * *",
                            "command": "mpm heartbeat alpaca_paper"
                        },
                        "heartbeat_hyperliquid_live": {
                            "schedule": "*/5 * * * *",
                            "command": "mpm heartbeat hyperliquid_live"
                        },
                        "heartbeat_hyperliquid_testnet": {
                            "schedule": "*/5 * * * *",
                            "command": "mpm heartbeat hyperliquid_testnet"
                        },
                        "heartbeat_ibkr_live": {
                            "schedule": "*/5 * * * *",
                            "command": "mpm heartbeat ibkr_live"
                        },
                        "heartbeat_ibkr_paper": {
                            "schedule": "*/5 * * * *",
                            "command": "mpm heartbeat ibkr_paper"
                        }
                    }
                },
                "tagline": "Kind von mpm",
                "website": "https://mpm.cloudron.van-rickelen.com",
                "iconUrl": "https://raw.githubusercontent.com/ernesta-jbl/mpm-kind-cloudron-versions/main/mpm-kind/icon.png",
                "packagerName": "Boris van Rickelen",
                "packagerUrl": "https://mpm.cloudron.van-rickelen.com",
                "minBoxVersion": "9.1.0",
                "description": "mpm in der Rolle Kind: zieht Freigaben und Zielgewichte von der Mutter und handelt das Broker-Konto des Betreibers.\n",
                "changelog": "* Erste Version im Katalog: Pull von der Mutter und Herzschlag-Kette je Konto.\n",
                "postInstallMessage": "Der erste Start ist absichtlich rot: ohne die drei Variablen unten bleiben Pull und Herzschlag-Kette still, und das Dashboard zeigt den Pull rot.\n\nVariablen setzen (Cloudron-CLI auf dem eigenen Rechner, `env set` startet die App neu):\n\n```\ncloudron env set --app mpm \\\n    MPM_KIND_ACCOUNTS=<Konten, kommagetrennt, z. B. alpaca_paper,ibkr_paper> \\\n    MPM_MUTTER_URL=https://mpm.cloudron.van-rickelen.com \\\n    MPM_MUTTER_TOKEN=<Token von Boris>\n```\n\nDanach die Broker-Keys auf der Dashboard-Seite `/secrets` eintragen und `cloudron restart --app mpm`.\n",
                "tags": [
                    "finance",
                    "trading"
                ],
                "mediaLinks": [
                    "https://raw.githubusercontent.com/ernesta-jbl/mpm-kind-cloudron-versions/main/mpm-kind/icon.png"
                ],
                "icon": "file://icon.png",
                "dockerImage": "container.cloudron.van-rickelen.com/mpm-kind:0.1.18"
            },
            "creationDate": "Wed, 28 Oct 2026 11:38:09 GMT",
            "ts": "Wed, 28 Oct 2026 12:19:39 GMT",
            "publishState": "revoked"
        }
    }
}